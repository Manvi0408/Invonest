# ============================================================================
# InvoNest — Integrations Platform (Phase 1) environment
# Copy to `.env` and fill in real values. The app boots and the Integrations UI
# works with these left EMPTY — each provider simply shows "Not configured"
# until its keys are present. Never commit the real .env.
# ============================================================================

# --- Core (already used by the app) ----------------------------------------
DATABASE_URL=postgresql://postgres:postgrespassword@127.0.0.1:5432/innovest?sslmode=disable
JWT_SECRET=
PORT=3001

# Public base URLs used to build OAuth redirect URIs and post-auth redirects.
# In local dev the OAuth callback must be reachable by the provider — use a
# tunnel (e.g. ngrok) and set BACKEND_PUBLIC_URL to the https tunnel origin.
BACKEND_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# 32-byte key (hex or base64) used to AES-256-GCM encrypt stored tokens/keys.
# Generate: openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY=

# Optional: enables BullMQ workers; without it, timers run the schedulers.
REDIS_URL=

# --- Accounting -------------------------------------------------------------
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_WEBHOOK_TOKEN=

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_KEY=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# --- CRM --------------------------------------------------------------------
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# --- Payments ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Communication ----------------------------------------------------------
# Gmail uses the Google OAuth client (shared with Sign-in with Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Business (Meta Cloud API) — Meta app credentials + webhook verify.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
